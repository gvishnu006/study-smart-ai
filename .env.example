# ---------------------------------------------------------------------------
# Study Smart AI — environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or local).
# Example Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/studysmart?retryWrites=true&w=majority
MONGODB_URI=

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The public URL of the app. Use http://localhost:3000 in development.
NEXTAUTH_URL=http://localhost:3000

# Anthropic (Claude) — required for all AI features (quiz generation, summaries,
# flashcards, doubt solver, study-plan generation and daily tips).
ANTHROPIC_API_KEY=
# Optional: override the model. Defaults to claude-sonnet-4-5.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google OAuth (optional — the button only appears when both are set).
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
